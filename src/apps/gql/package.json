{
  "name": "gql",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "dev-run": "pnpm run generate-graphql-types && pnpm run build && pnpm run start",
    "dev": "nodemon --watch ./src --ext ts,graphql,d.ts --exec \"pnpm run dev-run\"",
    "build": "tsc && copyfiles -u 1 \"src/**/*.graphql\" dist",
    "start": "node dist/index.js",
    "generate-graphql-types": "graphql-codegen --config ./src/graphql-codegen.ts",
    "generate-openapi-types:all": "pnpm generate-openapi-types:idp && pnpm generate-openapi-types:schedule && pnpm generate-openapi-types:calendar && pnpm generate-openapi-types:sync",
    "generate-openapi-types:idp": "openapi-typescript -o src/types/idp.d.ts https://appiecal-idp.k3s.home.klrnbk.nl/v3/api-docs",
    "generate-openapi-types:schedule": "openapi-typescript -o src/types/schedule.d.ts https://appiecal-schedule.k3s.home.klrnbk.nl/v3/api-docs",
    "generate-openapi-types:calendar": "openapi-typescript -o src/types/calendar.d.ts https://appiecal-calendar.k3s.home.klrnbk.nl/v3/api-docs",
    "generate-openapi-types:sync": "openapi-typescript -o src/types/sync.d.ts https://appiecal-sync.k3s.home.klrnbk.nl/v3/api-docs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@graphql-codegen/graphql-modules-preset": "^6.0.1",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@sapphire/eslint-config": "5.0.6",
    "@sapphire/ts-config": "5.0.3",
    "@types/node": "^25.9.2",
    "copyfiles": "^2.4.1",
    "eslint": "^10.4.1",
    "nodemon": "^3.1.14",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/load-files": "^7.0.1",
    "graphql-modules": "^3.1.1",
    "openapi-fetch": "^0.17.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  }
}
